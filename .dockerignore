# Allowlist: credentials, local data, Git history and virtualenvs never enter the build context.
**
!Dockerfile
!pyproject.toml
!app/
!app/**/*.py
!tests/
!tests/**/*.py
!frontend/
!frontend/package.json
!frontend/package-lock.json
!frontend/tsconfig*.json
!frontend/vite.config.ts
!frontend/index.html
!frontend/src/
!frontend/src/**/
!frontend/src/**/*.ts
!frontend/src/**/*.tsx
!frontend/src/**/*.css
