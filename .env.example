# Generate a unique value of at least 32 characters. Never commit the real value.
APP_API_KEY=

# Hackathon text-only LLM gateway.
LLM_GATEWAY_URL=https://api.softwaresystems.app
LLM_GATEWAY_API_KEY=
LLM_MODEL=global.anthropic.claude-sonnet-4-5-20250929-v1:0
LLM_TIMEOUT_SECONDS=120
LLM_MAX_OUTPUT_TOKENS=800
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.80

UPLOAD_DIR=data/uploads
MAX_UPLOAD_BYTES=5242880
PDF_MAX_PAGES=3
PDF_TIMEOUT_SECONDS=30
PDF_MAX_RENDER_PIXELS=30000000
# PDFs are inspected/rendered in a bounded worker. Keep one receipt per PDF.

# PaddleOCR is the default. Use tesseract to select the fallback provider.
OCR_ENGINE=paddle
PADDLE_LANGUAGE=en
PADDLE_DEVICE=cpu
PADDLE_MIN_CONFIDENCE=0.50

TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_LANGUAGE=eng
TESSERACT_PSM=6
OCR_TIMEOUT_SECONDS=30
# SQLite file path; keep this and receipt images on persistent local storage.
DATABASE_PATH=data/expenses.db

# Docker binds only to localhost. Stop local Uvicorn or change API_PORT to 8001.
API_PORT=8000
API_DOCS_ENABLED=true
